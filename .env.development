# -------------------------------------------------------------------------------------------
# Development Environment Variables
# In dev, VITE_BASE_URL is empty so requests route through Vite proxy (/api -> https://api.africafuture.co.za)
# This completely prevents browser CORS 405 Method Not Allowed on OPTIONS preflight
# -------------------------------------------------------------------------------------------

VITE_BASE_URL=''
VITE_API_BASE_URL=''
VITE_TOKEN_KEY='af_admin_tokens'
VITE_ACCESS_TOKEN_REFRESH_THRESHOLD_SECONDS=30
